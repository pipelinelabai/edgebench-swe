+function flattenGeometryCollection(geojson, properties) {
+    var features = [];
+    geomEach(geojson, function (geometry) {
+        switch (geometry.type) {
+        case 'MultiPoint':
+        case 'MultiLineString':
+        case 'MultiPolygon':
