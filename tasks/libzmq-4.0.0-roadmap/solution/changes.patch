new file mode 100644
index 00000000..2eef04ac
--- /dev/null
+++ b/tests/test_iov.cpp
@@ -0,0 +1,106 @@
+/*
+    Copyright (c) 2007-2013 Contributors as noted in the AUTHORS file
+
